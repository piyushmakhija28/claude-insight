# Runtime data tree. PathResolver falls back to LOCAL mode when ~/.claude/memory
# is absent (fresh machine, or CLAUDE_HOME pointed elsewhere) and creates
# data/{config,logs,sessions,anomalies,forecasts,performance} inside the repo via
# _ensure_local_structure(). All of it is generated runtime state, never source.
# Only data/users.json and data/sessions/ were ignored before, so the rest showed
# up as untracked and could be committed by accident.
/data/

# User database (contains password hashes - NEVER COMMIT)
data/users.json

# Session data
data/sessions/

# Flask session
flask_session/

# Security scan results
security-scan.json
bandit-report.json
safety-report.json

# Test coverage reports (auto-generated)
tests/htmlcov/
.coverage
htmlcov/

# Windows null device (created accidentally by some shells)
nul
context.toon.json

# Rule 45 SS 2 -- auto-generated diagrams, never committed
/uml/
/drawio/

# Regenerable call-graph analysis output (each >500 KB, blocked by the
# check-added-large-files pre-commit gate). Rebuild from source per
# docs/phase-5-uml/callgraph_coverage_probe.md.
docs/phase-0-reverse-engineering/ast_call_graph.json
docs/phase-0-reverse-engineering/codebase_kg/edges.json
docs/phase-0-reverse-engineering/codebase_kg/nodes.json
